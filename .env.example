# Server-only. Never commit real values.
GOOGLE_AIR_QUALITY_API_KEY=
FIRMS_MAP_KEY=

# Sent to browsers. Restrict it to your domains (HTTP referrers) and to the Maps JavaScript API only.
PUBLIC_GOOGLE_MAPS_API_KEY=

# Public origin for canonical URLs, sitemap.xml and robots.txt (e.g. https://niskala.id).
SITE_URL=
